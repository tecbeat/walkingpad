# Rename to secrets.yaml and fill in your values.
# secrets.yaml is gitignored - never commit real credentials.

wifi_ssid: your-wifi-ssid
wifi_password: your-wifi-password

# Generate with: docker compose -f ../../docker-compose.esphome.yml exec esphome esphome config-encryption
# Or online: https://esphome.io/components/api.html
api_encryption_key: "REPLACE-WITH-BASE64-32-BYTE-KEY"

# Any strong password. Only used for OTA authentication.
ota_password: "REPLACE-WITH-A-STRONG-PASSWORD"
